#!/usr/bin/env python3
"""Stream live file diffs and Git activity in a repository."""
import argparse
import difflib
import hashlib
import os
from pathlib import Path
import stat
import subprocess
import sys
import time

INTERVAL = 0.5
MAX_BYTES = 1024 * 1024


def git(root, *args):
    result = subprocess.run(
        ['git', '-C', str(root), *args], stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'},
        timeout=10,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.decode(errors='replace').strip())
    return result.stdout


def safe(text):
    # A diff should display file contents, never execute terminal escape sequences.
    return ''.join(c if c in '\n\t' or (ord(c) >= 32 and not 127 <= ord(c) <= 159)
                   else f'\\x{ord(c):02x}' for c in text)


def filename(name):
    return safe(name).replace('\n', '\\n').replace('\t', '\\t')


def stamp(path):
    try:
        info = path.stat()
        return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns
    except OSError:
        return None


class GitActivity:
    """Follow new local records without replaying history or configuring Git."""
    def __init__(self, root):
        paths = git(root, 'rev-parse', '--path-format=absolute',
                    '--git-path', 'logs/HEAD', '--git-path', 'logs/refs/remotes',
                    '--git-path', 'FETCH_HEAD').decode(errors='surrogateescape').splitlines()
        self.head, self.remotes, self.fetch_head = map(Path, paths)
        self.positions = {}
        for path, ref in self.logs():
            info = stamp(path)
            if info:
                self.positions[path] = (info[:2], info[2])
        self.fetched = stamp(self.fetch_head)

    def logs(self):
        yield self.head, 'HEAD'
        if self.remotes.is_dir():
            for path in sorted(self.remotes.rglob('*')):
                relative = path.relative_to(self.remotes)
                # The remote's HEAD alias is bookkeeping, not another transfer.
                if len(relative.parts) == 2 and relative.name == 'HEAD':
                    continue
                if path.is_file() and not path.name.endswith('.lock'):
                    yield path, relative.as_posix()

    def read(self, path):
        info = stamp(path)
        if not info:
            self.positions.pop(path, None)
            return []
        identity, position = self.positions.get(path, (info[:2], 0))
        if identity != info[:2] or info[2] < position:
            # Expiring/rewriting a reflog is not a new batch of Git operations.
            self.positions[path] = (info[:2], info[2])
            return []
        try:
            with path.open('rb') as stream:
                stream.seek(position)
                data = stream.read()
        except OSError:
            return []
        end = data.rfind(b'\n') + 1
        self.positions[path] = (info[:2], position + end)
        return data[:end].splitlines()

    def poll(self, color):
        events = []
        for path, ref in self.logs():
            for line in self.read(path):
                try:
                    metadata, message = line.split(b'\t', 1)
                    fields = metadata.split()
                    commit = fields[1].decode()[:8]
                    occurred = int(fields[-2])
                    message = message.decode(errors='replace')
                    action, _, detail = message.partition(': ')
                    command = action.split()[0]
                except (ValueError, IndexError):
                    continue
                if command == 'commit' and ref == 'HEAD':
                    text = f'COMMIT {commit} · {detail}'
                elif command in ('fetch', 'pull'):
                    text = f'{command.upper()} {ref} → {commit} · {detail}'
                elif message == 'update by push':
                    text = f'PUSH {ref} → {commit}'
                else:
                    continue
                events.append((occurred, command, text))
        fetched = stamp(self.fetch_head)
        if fetched and fetched != self.fetched and not any(e[1] in ('fetch', 'pull') for e in events):
            # FETCH_HEAD can change even when no refs move. It cannot tell us
            # whether the caller was fetch or pull, or prove command success.
            events.append((time.time(), 'fetch', 'FETCH/PULL activity · FETCH_HEAD updated'))
        self.fetched = fetched
        for occurred, command, text in sorted(events, key=lambda event: event[0]):
            line = f'[{time.strftime("%H:%M:%S", time.localtime(occurred))}] Git {filename(text)}'
            print(f'\033[1;35m{line}\033[0m' if color else line)
            print(flush=True)


def snapshot(root, previous):
    names = set(git(root, 'ls-files', '-z', '--cached', '--others', '--exclude-standard').split(b'\0'))
    current = {}
    for raw in sorted(names - {b''}):
        name = os.fsdecode(raw)
        path = root / name
        old = previous.get(name)
        try:
            # Stay in this checkout; do not read through symlinked directories.
            if path.is_symlink() or any(p.is_symlink() for p in path.parents if p != root and root in p.parents):
                continue
            info = path.stat()
            if not stat.S_ISREG(info.st_mode):
                continue
            signature = (info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
            if old and old[0] == signature:
                current[name] = old
                continue
            if info.st_size > MAX_BYTES:
                current[name] = (signature, None, signature, 'File exceeds 1 MiB; text diff omitted')
                continue
            with path.open('rb') as stream:
                data = stream.read(MAX_BYTES + 1)
            after = path.stat()
            if signature != (after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                if old:
                    current[name] = old  # Try again next tick after the write settles.
                continue
            try:
                text = data.decode('utf-8') if b'\0' not in data else None
            except UnicodeDecodeError:
                text = None
            current[name] = (signature, text, hashlib.sha256(data).digest(), 'Binary/non-UTF-8 file; text diff omitted')
        except (FileNotFoundError, NotADirectoryError):
            continue
        except OSError:
            # A temporarily unreadable file must not look like a deletion.
            if old:
                current[name] = old
    return current


def show(name, before, after, color):
    def paint(text, code):
        return f'\033[{code}m{text}\033[0m' if color else text

    action = 'Created' if before is None else 'Deleted' if after is None else 'Modified'
    name = filename(name)
    print(paint(f'[{time.strftime("%H:%M:%S")}] {action} {name}', '1;36'))
    unavailable = [item[3] for item in (before, after) if item is not None and item[1] is None]
    if unavailable:
        print('; '.join(dict.fromkeys(unavailable)))
    else:
        old = before[1] if before else ''
        new = after[1] if after else ''
        lines = difflib.unified_diff(
            old.splitlines(keepends=True), new.splitlines(keepends=True),
            fromfile=f'a/{name}' if before else '/dev/null',
            tofile=f'b/{name}' if after else '/dev/null', n=3,
        )
        for line in lines:
            code = '32' if line.startswith('+') else '31' if line.startswith('-') else '36' if line.startswith('@@') else '0'
            print(paint(safe(line).rstrip('\n'), code))
            if not line.endswith('\n'):
                print('\\ No newline at end of file')
    print(flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory', nargs='?', default='.', help='Repository to watch (default: current directory)')
    args = parser.parse_args()
    root = Path(args.directory).expanduser().resolve()
    root = Path(os.fsdecode(git(root, 'rev-parse', '--show-toplevel')).rstrip('\n'))
    print(f'Diffdigger · {root}', file=sys.stderr)
    activity = GitActivity(root)
    previous = snapshot(root, {})
    print('Ready. Watching file saves and Git activity. Ctrl+C to stop.', file=sys.stderr, flush=True)
    color = sys.stdout.isatty() and 'NO_COLOR' not in os.environ
    while True:
        time.sleep(INTERVAL)
        activity.poll(color)
        current = snapshot(root, previous)
        for name in sorted(previous.keys() | current.keys()):
            before, after = previous.get(name), current.get(name)
            if before and after and before[2] == after[2]:
                continue
            if after is None and (root / name).exists():
                continue  # A newly ignored file is not a deleted file.
            show(name, before, after, color)
        previous = current


if __name__ == '__main__':
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f'diffdigger: {error}', file=sys.stderr)
        sys.exit(1)

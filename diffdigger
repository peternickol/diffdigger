#!/usr/bin/env python3
"""Stream live file diffs from directories, with optional Git activity."""
import argparse
import difflib
import hashlib
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import time
import unicodedata

INTERVAL = 0.5
MAX_BYTES = 1024 * 1024


def git(root, *args):
    result = subprocess.run(
        ['git', '-C', str(root), *args], stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'},
        timeout=10,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.decode(errors='replace').strip())
    return result.stdout


def safe(text):
    # A diff should display file contents, never execute terminal escape sequences.
    return ''.join(c if c in '\n\t' or (ord(c) >= 32 and not 127 <= ord(c) <= 159)
                   else f'\\x{ord(c):02x}' for c in text)


def filename(name):
    return safe(name).replace('\n', '\\n').replace('\t', '\\t')


def stamp(path):
    try:
        info = path.stat()
        return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns
    except OSError:
        return None


class GitActivity:
    """Follow new local records without replaying history or configuring Git."""
    def __init__(self, root):
        paths = git(root, 'rev-parse', '--path-format=absolute',
                    '--git-path', 'logs/HEAD', '--git-path', 'logs/refs/remotes',
                    '--git-path', 'FETCH_HEAD').decode(errors='surrogateescape').splitlines()
        self.head, self.remotes, self.fetch_head = map(Path, paths)
        self.positions = {}
        for path, ref in self.logs():
            info = stamp(path)
            if info:
                self.positions[path] = (info[:2], info[2])
        self.fetched = stamp(self.fetch_head)

    def logs(self):
        yield self.head, 'HEAD'
        if self.remotes.is_dir():
            for path in sorted(self.remotes.rglob('*')):
                relative = path.relative_to(self.remotes)
                # The remote's HEAD alias is bookkeeping, not another transfer.
                if len(relative.parts) == 2 and relative.name == 'HEAD':
                    continue
                if path.is_file() and not path.name.endswith('.lock'):
                    yield path, relative.as_posix()

    def read(self, path):
        info = stamp(path)
        if not info:
            self.positions.pop(path, None)
            return []
        identity, position = self.positions.get(path, (info[:2], 0))
        if identity != info[:2] or info[2] < position:
            # Expiring/rewriting a reflog is not a new batch of Git operations.
            self.positions[path] = (info[:2], info[2])
            return []
        try:
            with path.open('rb') as stream:
                stream.seek(position)
                data = stream.read()
        except OSError:
            return []
        end = data.rfind(b'\n') + 1
        self.positions[path] = (info[:2], position + end)
        return data[:end].splitlines()

    def poll(self, renderer):
        events = []
        for path, ref in self.logs():
            for line in self.read(path):
                try:
                    metadata, message = line.split(b'\t', 1)
                    fields = metadata.split()
                    commit = fields[1].decode()[:8]
                    occurred = int(fields[-2])
                    message = message.decode(errors='replace')
                    action, _, detail = message.partition(': ')
                    command = action.split()[0]
                except (ValueError, IndexError):
                    continue
                if command == 'commit' and ref == 'HEAD':
                    text = f'COMMIT {commit} · {detail}'
                elif command in ('fetch', 'pull'):
                    text = f'{command.upper()} {ref} → {commit} · {detail}'
                elif message == 'update by push':
                    text = f'PUSH {ref} → {commit}'
                else:
                    continue
                events.append((occurred, command, text))
        fetched = stamp(self.fetch_head)
        if fetched and fetched != self.fetched and not any(e[1] in ('fetch', 'pull') for e in events):
            # FETCH_HEAD can change even when no refs move. It cannot tell us
            # whether the caller was fetch or pull, or prove command success.
            events.append((time.time(), 'fetch', 'FETCH/PULL activity · FETCH_HEAD updated'))
        self.fetched = fetched
        for occurred, command, text in sorted(events, key=lambda event: event[0]):
            renderer.git_event(occurred, text)


def snapshot(root, previous, tracking=None, progress=None):
    """Read the filesystem directly; Git can optionally supply ignore rules."""
    current = {}
    unreadable = []
    if tracking:
        tracking.begin()

    def scan_error(error):
        if not isinstance(error, (FileNotFoundError, NotADirectoryError)):
            unreadable.append(Path(error.filename))

    def files():
        for directory, children, names in os.walk(root, onerror=scan_error, followlinks=False):
            directory = Path(directory)
            if progress:
                progress.update(directory, len(current), tracking.active if tracking else ())
            ignored = set()
            if tracking:
                tracking.visit(directory, '.git' in children or '.git' in names)
                ignored = tracking.ignored(directory)
            if any(parent in ignored for parent in (directory, *directory.parents)):
                children.clear()
                continue
            children[:] = [name for name in children if name != '.git'
                           and directory / name not in ignored
                           and not (directory / name).is_symlink()]
            relative = directory.relative_to(root).as_posix()
            prefix = '' if relative == '.' else relative + '/'
            for name in names:
                path = directory / name
                if name != '.git' and path not in ignored:
                    yield prefix + name, path

    for name, path in files():
        if progress:
            progress.update(path, len(current), tracking.active if tracking else ())
        old = previous.get(name)
        try:
            # lstat both identifies symlinks and gets the file signature in one call.
            info = path.lstat()
            if not stat.S_ISREG(info.st_mode):
                continue
            signature = (info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
            if old and old[0] == signature:
                current[name] = old
                continue
            if info.st_size > MAX_BYTES:
                current[name] = (signature, None, signature, 'File exceeds 1 MiB; text diff omitted')
                continue
            with path.open('rb') as stream:
                data = stream.read(MAX_BYTES + 1)
            after = path.stat()
            if signature != (after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                if old:
                    current[name] = old  # Try again next tick after the write settles.
                continue
            try:
                text = data.decode('utf-8') if b'\0' not in data else None
            except UnicodeDecodeError:
                text = None
            current[name] = (signature, text, hashlib.sha256(data).digest(), 'Binary/non-UTF-8 file; text diff omitted')
        except (FileNotFoundError, NotADirectoryError):
            continue
        except OSError:
            # A temporarily unreadable file must not look like a deletion.
            if old:
                current[name] = old
    for directory in unreadable:
        relative = directory.relative_to(root).as_posix()
        prefix = '' if relative == '.' else relative + '/'
        for name, old in previous.items():
            if name.startswith(prefix):
                current.setdefault(name, old)
    return current


def show(name, before, after, color, stream=None, repo=None):
    stream = stream if stream is not None else sys.stdout
    def paint(text, code):
        return f'\033[{code}m{text}\033[0m' if color else text

    action = 'Created' if before is None else 'Deleted' if after is None else 'Modified'
    name = filename(name)
    label = f' [{filename(repo)}]' if repo is not None else ''
    print(paint(f'[{time.strftime("%H:%M:%S")}]{label} {action} {name}', '1;36'), file=stream)
    unavailable = [item[3] for item in (before, after) if item is not None and item[1] is None]
    if unavailable:
        print('; '.join(dict.fromkeys(unavailable)), file=stream)
    else:
        old = before[1] if before else ''
        new = after[1] if after else ''
        lines = difflib.unified_diff(
            old.splitlines(keepends=True), new.splitlines(keepends=True),
            fromfile=f'a/{name}' if before else '/dev/null',
            tofile=f'b/{name}' if after else '/dev/null', n=3,
        )
        for line in lines:
            code = '32' if line.startswith('+') else '31' if line.startswith('-') else '36' if line.startswith('@@') else '0'
            print(paint(safe(line).rstrip('\n'), code), file=stream)
            if not line.endswith('\n'):
                print('\\ No newline at end of file', file=stream)
    print(file=stream, flush=True)


def cell_width(text):
    return sum(0 if unicodedata.combining(c) or unicodedata.category(c) in ('Cf', 'Mn', 'Me')
               else 2 if unicodedata.east_asian_width(c) in ('W', 'F') else 1 for c in text)


def wrap_cells(text, width):
    line, used = '', 0
    for character in text.expandtabs(4):
        size = cell_width(character)
        if used + size > width and line:
            yield line
            line, used = '', 0
        line += character
        used += size
    yield line


class StartupProgress:
    """Show baseline work without writing progress into the diff stream."""
    def __init__(self, plain=False, stream=None, columns=None):
        self.stream = stream if stream is not None else sys.stderr
        self.columns = columns
        self.interactive = self.stream.isatty() and os.environ.get('TERM') != 'dumb' and not plain
        self.started = time.monotonic()
        self.last_update = float('-inf')
        self.files = 0
        self.repos = set()
        self.frame = 0
        self.visible = False

    def __enter__(self):
        self.update(None, 0, (), force=True)
        return self

    def __exit__(self, error_type, error, traceback):
        if error_type is None:
            elapsed = time.monotonic() - self.started
            self.write(f'Baseline ready · {self.files:,} files'
                       f' · {len(self.repos)} Git repos · {elapsed:.1f}s', final=True)
        elif self.interactive and self.visible:
            print('\r\033[2K', end='', file=self.stream, flush=True)

    def write(self, text, final=False):
        if self.interactive:
            width = max(1, (self.columns or shutil.get_terminal_size((100, 24)).columns) - 1)
            if cell_width(text) > width:
                text = next(wrap_cells(text, width - 1)) + '…' if width > 1 else '…'
            print('\r\033[2K' + text, end='\n' if final else '', file=self.stream, flush=True)
            self.visible = not final
        else:
            print(text, file=self.stream, flush=True)

    def update(self, path, files, repos, force=False):
        now = time.monotonic()
        if not force and now - self.last_update < (0.1 if self.interactive else 1.0):
            return
        self.last_update = now
        total_repos = len(self.repos.union(repos))
        counts = f'{self.files + files:,} files'
        if total_repos:
            counts += f' · {total_repos} Git repos'
        text = f'Building baseline · {counts} · {now - self.started:.1f}s'
        if path is not None:
            display = str(path).replace(str(Path.home()), '~', 1)
            text += ' · ' + filename(display)
        if self.interactive:
            text = '⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'[self.frame % 10] + ' ' + text
            self.frame += 1
        self.write(text)

    def complete(self, watcher):
        self.files += len(watcher.previous)
        self.repos.update(watcher.tracking.active)


class Terminal:
    COLORS = {
        'text': '38;2;192;202;245', 'muted': '38;2;132;143;174',
        'border': '38;2;65;72;104', 'blue': '38;2;122;162;247',
        'green': '38;2;158;206;106', 'red': '38;2;247;118;142',
        'purple': '38;2;187;154;247', 'cyan': '38;2;125;207;255',
        'added': '38;2;182;224;144;48;2;30;47;39',
        'removed': '38;2;255;158;172;48;2;53;33;43',
    }

    def __init__(self, plain=False, stream=None, columns=None, repo=None, kind='repo'):
        self.stream = stream if stream is not None else sys.stdout
        self.columns = columns
        self.repo = repo
        self.kind = kind
        self.tty = self.stream.isatty() and os.environ.get('TERM') != 'dumb' and not plain
        self.color = self.tty and 'NO_COLOR' not in os.environ

    @property
    def width(self):
        return min(112, (self.columns or shutil.get_terminal_size((100, 24)).columns) - 4)

    @property
    def pretty(self):
        return self.tty and self.width >= 46

    def paint(self, text, style='text', bold=False):
        code = self.COLORS[style] + (';1' if bold else '')
        return f'\033[{code}m{text}\033[0m' if self.color else text

    def line(self, text=''):
        print(text, file=self.stream)

    def border(self, left='╭', right='╮'):
        self.line('  ' + self.paint(left + '─' * (self.width - 2) + right, 'border'))

    def row(self, *spans):
        used = sum(cell_width(span[0]) for span in spans)
        content = ''.join(self.paint(span[0], span[1], len(span) > 2 and span[2]) for span in spans)
        edge = self.paint('│', 'border')
        self.line('  ' + edge + content + ' ' * max(0, self.width - 2 - used) + edge)

    def paragraph(self, text, style='text'):
        for line in wrap_cells(text, self.width - 4):
            self.row((' ' + line, style))

    def header(self, label, clock, style, clock_style='muted'):
        self.border()
        gap = self.width - 4 - cell_width(label) - cell_width(clock)
        self.row((' ' + label, style, True), (' ' * gap + clock + ' ', clock_style))

    def close(self):
        self.border('╰', '╯')
        self.line()
        self.stream.flush()

    def start(self, root):
        if not self.pretty:
            print(f'Diffdigger · {filename(str(root))}', file=sys.stderr)
            print('Ready. Watching file saves; Git activity when available. Ctrl+C to stop.', file=sys.stderr, flush=True)
            return
        self.line()
        self.header('DIFFDIGGER', '● LIVE', 'cyan', 'green')
        self.paragraph(filename(root.name), 'blue')
        self.paragraph(filename(str(root).replace(str(Path.home()), '~', 1)), 'muted')
        self.border('├', '┤')
        self.paragraph('File diffs · Git activity when available · Ctrl+C to stop', 'muted')
        self.close()
        self.line('  ' + self.paint('Watching for file saves…', 'muted'))
        self.line()
        self.stream.flush()

    def start_many(self, roots):
        title = f'{len(roots)} directories'
        if not self.pretty:
            print(f'Diffdigger · {title}', file=sys.stderr)
            for root in roots:
                print(f'  {filename(str(root))}', file=sys.stderr)
            print('Ready. Watching file saves; Git activity when available. Ctrl+C to stop.', file=sys.stderr, flush=True)
            return
        self.line()
        self.header('DIFFDIGGER', '● LIVE', 'cyan', 'green')
        self.paragraph(title, 'blue')
        for root in roots:
            self.paragraph(filename(str(root).replace(str(Path.home()), '~', 1)), 'muted')
        self.border('├', '┤')
        self.paragraph('File diffs · Git activity when available · Ctrl+C to stop', 'muted')
        self.close()

    def git_event(self, occurred, text):
        clock = time.strftime('%H:%M:%S', time.localtime(occurred))
        text = filename(text)
        if not self.pretty:
            label = f' [{filename(self.repo)}]' if self.repo is not None else ''
            self.line(f'[{clock}]{label} Git {text}')
            self.line()
            self.stream.flush()
            return
        action, _, detail = text.partition(' ')
        style = {'COMMIT': 'purple', 'PUSH': 'cyan', 'PULL': 'blue', 'FETCH': 'green'}.get(action, 'muted')
        self.header('GIT / ' + action, clock, style)
        if self.repo is not None:
            self.paragraph(self.kind + ' · ' + filename(self.repo), 'cyan')
        reference, separator, message = detail.partition(' · ')
        self.paragraph(reference, style)
        if separator and message:
            self.paragraph(message)
        self.close()

    def file_event(self, name, before, after):
        if not self.pretty:
            show(name, before, after, self.color, self.stream, self.repo)
            return
        action = 'CREATED' if before is None else 'DELETED' if after is None else 'MODIFIED'
        accent = 'green' if before is None else 'red' if after is None else 'blue'
        unavailable = [item[3] for item in (before, after) if item is not None and item[1] is None]
        old = (before[1] if before and before[1] is not None else '').splitlines(keepends=True)
        new = (after[1] if after and after[1] is not None else '').splitlines(keepends=True)
        matcher = difflib.SequenceMatcher(None, old, new)
        operations = matcher.get_opcodes()
        added = sum(j2 - j1 for tag, i1, i2, j1, j2 in operations if tag in ('insert', 'replace'))
        removed = sum(i2 - i1 for tag, i1, i2, j1, j2 in operations if tag in ('delete', 'replace'))
        self.header(action, time.strftime('%H:%M:%S'), accent)
        if self.repo is not None:
            self.paragraph(self.kind + ' · ' + filename(self.repo), 'cyan')
        name = filename(name)
        counts = f'+{added}  −{removed}' if not unavailable else ''
        if cell_width(name) + cell_width(counts) + 3 <= self.width - 2:
            padding = self.width - 5 - cell_width(name) - cell_width(counts)
            self.row((' ' + name, 'text', True), (' ' * padding, 'text'),
                     (f' +{added}', 'green') if counts else ('', 'text'),
                     (f'  −{removed} ', 'red') if counts else ('', 'text'))
        else:
            self.paragraph(name)
            if counts:
                self.row((f' +{added}', 'green'), (f'  −{removed}', 'red'))
        self.border('├', '┤')
        if unavailable:
            for detail in dict.fromkeys(unavailable):
                self.paragraph(detail, 'muted')
        elif not old and not new:
            self.paragraph('Empty file', 'muted')
        else:
            digits = max(3, len(str(max(len(old), len(new)))))
            body_width = self.width - 2 * digits - 9
            for group in matcher.get_grouped_opcodes(3):
                first, last = group[0], group[-1]
                old_count, new_count = last[2] - first[1], last[4] - first[3]
                hunk = f'@@ −{first[1] + bool(old_count)},{old_count} +{first[3] + bool(new_count)},{new_count} @@'
                self.paragraph(hunk, 'muted')
                for tag, i1, i2, j1, j2 in group:
                    rows = []
                    if tag == 'equal':
                        rows = [(i + 1, j1 + i - i1 + 1, ' ', old[i]) for i in range(i1, i2)]
                    else:
                        if tag in ('delete', 'replace'):
                            rows.extend((i + 1, '', '−', old[i]) for i in range(i1, i2))
                        if tag in ('insert', 'replace'):
                            rows.extend(('', j + 1, '+', new[j]) for j in range(j1, j2))
                    for left, right, sign, line in rows:
                        style = 'added' if sign == '+' else 'removed' if sign == '−' else 'text'
                        for index, part in enumerate(wrap_cells(safe(line.rstrip('\n')), body_width)):
                            a, b = (str(left), str(right)) if index == 0 else ('', '')
                            marker = sign if index == 0 else '↳'
                            gutter = f' {a:>{digits}} {b:>{digits}} '
                            padded = part + ' ' * (body_width - cell_width(part))
                            self.row((gutter, 'muted'), ('│', 'border'), (f' {marker} {padded}', style))
                        if not line.endswith('\n'):
                            self.paragraph('↳ No newline at end of file', 'muted')
        self.close()


def repository_root(path):
    return Path(os.fsdecode(git(path, 'rev-parse', '--show-toplevel')).rstrip('\n')).resolve()


def watch_directories(directories):
    roots = {}
    for directory in directories:
        path = Path(directory).expanduser().resolve()
        if not path.is_dir():
            raise RuntimeError(f'Not a directory: {path}')
        roots[path] = None
    # A parent directory already covers any explicitly supplied descendants.
    return [path for path in roots if not any(parent in roots for parent in path.parents)]


def repository_labels(roots):
    names = [root.name for root in roots]
    return {root: root.name if names.count(root.name) == 1 else str(root) for root in roots}


class GitTracking:
    """Optional metadata and filtering; failures never stop filesystem diffs."""
    def __init__(self, root, renderer):
        self.root, self.base = root, renderer
        self.available = shutil.which('git') is not None
        self.known, self.failed, self.errors = {}, {}, {}
        self.active, self.exclusions = set(), {}
        self.enclosing = None
        if self.available:
            try:
                self.enclosing = repository_root(root)
            except (OSError, RuntimeError, subprocess.TimeoutExpired):
                pass

    def begin(self):
        self.active, self.exclusions = set(), {}
        self.base.kind = 'folder'

    def visit(self, directory, has_git):
        if not self.available:
            return
        root = directory if has_git else self.enclosing if directory == self.root else None
        if root is None or not (root / '.git').exists():
            return
        marker = stamp(root / '.git')
        if root not in self.known:
            if root in self.failed and self.failed[root] == marker:
                return
            try:
                self.known[root] = GitActivity(root)
            except (OSError, RuntimeError, subprocess.TimeoutExpired):
                self.failed[root] = marker
                return
        self.active.add(root)
        if root == self.root:
            self.base.kind = 'repo'

    def context(self, path):
        return next((parent for parent in (path, *path.parents) if parent in self.active), None)

    def report(self, root, error):
        message = str(error)
        if self.errors.get(root) != message:
            print(f'diffdigger: [{filename(str(root))}] Git unavailable; continuing file diffs: '
                  f'{filename(message)}', file=sys.stderr, flush=True)
        self.errors[root] = message

    def ignored(self, directory):
        root = self.context(directory)
        if root is None:
            return set()
        if root not in self.exclusions:
            try:
                # Git supplies exclusions only. The walker finds the actual files.
                names = git(root, 'ls-files', '-z', '--others', '--ignored', '--exclude-standard', '--directory')
                self.exclusions[root] = {root / os.fsdecode(name).rstrip('/')
                                         for name in names.split(b'\0') if name}
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                self.report(root, error)
                self.exclusions[root] = set()
        return self.exclusions[root]

    def renderer(self, root):
        if root == self.root or root in self.root.parents:
            return self.base
        label = repository_labels(self.active)[root]
        return Terminal(plain=not self.base.tty, stream=self.base.stream,
                        columns=self.base.columns, repo=label)

    def file_event(self, name, before, after):
        path = self.root / name
        root = self.context(path)
        if root is not None and self.root in root.parents:
            self.renderer(root).file_event(path.relative_to(root).as_posix(), before, after)
        else:
            self.base.file_event(name, before, after)

    def poll(self):
        for root in sorted(self.active):
            try:
                self.known[root].poll(self.renderer(root))
            except BrokenPipeError:
                raise
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                self.report(root, error)


class Watcher:
    def __init__(self, root, renderer, progress=None):
        self.root = root
        self.renderer = renderer
        if progress:
            progress.update(root, 0, (), force=True)
        self.tracking = GitTracking(root, renderer)
        self.previous = snapshot(root, {}, self.tracking, progress)
        self.error = None

    def poll(self):
        if not self.root.is_dir():
            raise RuntimeError('Directory is unavailable; waiting for it to return')
        current = snapshot(self.root, self.previous, self.tracking)
        self.tracking.poll()
        for name in sorted(self.previous.keys() | current.keys()):
            before, after = self.previous.get(name), current.get(name)
            if before and after and before[2] == after[2]:
                continue
            if after is None and (self.root / name).exists():
                continue  # A newly ignored file is not a deleted file.
            self.tracking.file_event(name, before, after)
        self.previous = current


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directories', nargs='*', help='Directories to watch recursively (default: current directory)')
    parser.add_argument('--plain', action='store_true', help='Use plain unified diffs without terminal cards')
    args = parser.parse_args()
    with StartupProgress(plain=args.plain) as progress:
        roots = watch_directories(args.directories or ['.'])
        labels = repository_labels(roots)
        multiple = len(roots) > 1
        watchers = []
        for root in roots:
            watcher = Watcher(root, Terminal(plain=args.plain, repo=labels[root] if multiple else None,
                                             kind='folder'), progress)
            watchers.append(watcher)
            progress.complete(watcher)
    renderer = Terminal(plain=args.plain)
    if multiple:
        renderer.start_many(roots)
    else:
        renderer.start(roots[0])
    while True:
        time.sleep(INTERVAL)
        for watcher in watchers:
            try:
                watcher.poll()
            except BrokenPipeError:
                raise
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                if not multiple:
                    raise
                message = str(error)
                if message != watcher.error:
                    print(f'diffdigger: [{filename(labels[watcher.root])}] {filename(message)}',
                          file=sys.stderr, flush=True)
                watcher.error = message
            else:
                if watcher.error:
                    print(f'diffdigger: [{filename(labels[watcher.root])}] Watching again.',
                          file=sys.stderr, flush=True)
                watcher.error = None


if __name__ == '__main__':
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f'diffdigger: {error}', file=sys.stderr)
        sys.exit(1)
